# Backend
API_PORT=4000
DB_HOST=db
DB_PORT=5432
DB_USER=travel_app
DB_PASSWORD=travel_pass
DB_NAME=travel_db
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DEFAULT_TTL=300
REDIS_TRIPS_TTL=300
REDIS_TRIP_TTL=300
REDIS_LOCATIONS_TTL=300
REDIS_KEY_PREFIX=travel_cache

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# When using Docker, override API_BASE_URL to the internal service URL (e.g. http://api:4000)
# Otherwise it will fall back to NEXT_PUBLIC_API_BASE_URL
# API_BASE_URL=http://api:4000
